# ---------------------------------------------------------------------------
# BE-3 — Event-Driven Multi-Tenant E-Commerce Inventory & Order Processing
# Copy this file to .env and adjust values for your local environment.
# DO NOT commit .env (it is git-ignored). Never hardcode secrets in source.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Order Service
# ---------------------------------------------------------------------------
ORDER_SERVICE_PORT=8001

# Logging (INFO / DEBUG / WARNING / ERROR). Emitted as one JSON object per line.
LOG_LEVEL=INFO

# PostgreSQL (per-domain order database)
# ORDER_DB_HOST documents the Docker service name. ORDER_DB_HOST_PORT is the
# host port for psql from your machine (maps to container port 5432).
ORDER_DB_HOST=order-db
ORDER_DB_HOST_PORT=54321
ORDER_DB_NAME=orderdb
ORDER_DB_USER=postgres
ORDER_DB_PASSWORD=postgres

# RabbitMQ (shared)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ---------------------------------------------------------------------------
# Inventory Service
# ---------------------------------------------------------------------------
INVENTORY_SERVICE_PORT=8002

# Logging (INFO / DEBUG / WARNING / ERROR). Emitted as one JSON object per line.
LOG_LEVEL=INFO

# PostgreSQL (per-domain inventory database)
# INVENTORY_DB_HOST_PORT is the host port for psql (maps to container 5432).
INVENTORY_DB_HOST=inventory-db
INVENTORY_DB_HOST_PORT=54322
INVENTORY_DB_NAME=inventorydb
INVENTORY_DB_USER=postgres
INVENTORY_DB_PASSWORD=postgres

# RabbitMQ (shared)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
